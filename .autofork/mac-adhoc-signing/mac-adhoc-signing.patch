+
+it("pins ad-hoc builds to their bundle id so later builds can update them", async () => {
+  const options = {
+    app: "/tmp/T3 Code.app",
+    identity: "-",
+    optionsForFile: () => ({ entitlements: "/tmp/t3code.entitlements.plist" }),
+  } satisfies SignOptions;
+
+  await sign(options, { appInfo: { id: "com.t3tools.t3code" } });
+
+  const { optionsForFile } = vi.mocked(signApplication).mock.lastCall![0];
+  const context = { platform: "darwin" } as const;
+  expect(optionsForFile!("/tmp/T3 Code.app", context)).toEqual({
+    entitlements: "/tmp/t3code.entitlements.plist",
+    timestamp: "none",
+    requirements: '=designated => identifier "com.t3tools.t3code"',
+  });
+  expect(
+    optionsForFile!("/tmp/T3 Code.app/Contents/Frameworks/T3 Code Helper.app", context),
+  ).toEqual({ entitlements: "/tmp/t3code.entitlements.plist", timestamp: "none" });
+});
diff --git a/scripts/sign-macos.ts b/scripts/sign-macos.ts
index 6d00d13f13b9a600ff773ff3d52f11f64eea1841..d3b08466dfcacefd318c4f75239e304a2f69e05d 100644
--- a/scripts/sign-macos.ts
+++ b/scripts/sign-macos.ts
@@ -1,5 +1,26 @@
 import { sign as signApplication, type SignOptions } from "@electron/osx-sign";
 
-export default async function sign(options: SignOptions): Promise<void> {
-  await signApplication({ ...options, batchCodesignCalls: true });
+interface Packager {
+  readonly appInfo: { readonly id: string };
+}
+
+export default async function sign(options: SignOptions, packager?: Packager): Promise<void> {
+  await signApplication({
+    ...options,
+    ...(options.identity === "-" && packager ? adHoc(options, packager.appInfo.id) : {}),
+    batchCodesignCalls: true,
+  });
+}
+
+// Squirrel.Mac installs an update only if it satisfies the running app's
+// designated requirement. An ad-hoc signature's default requirement is its own
+// cdhash, which no later build can match, so the app pins it to its bundle id.
+function adHoc(options: SignOptions, appId: string): Pick<SignOptions, "optionsForFile"> {
+  return {
+    optionsForFile: (filePath, context) => ({
+      ...options.optionsForFile?.(filePath, context),
+      timestamp: "none",
+      ...(filePath === options.app ? { requirements: `=designated => identifier "${appId}"` } : {}),
+    }),
+  };
 }
